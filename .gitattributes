# Line-ending policy — added 2026-07-06 after Windows tooling rewrote
# src/*.py and docs from LF to CRLF, producing whole-file diffs with zero
# content change (see session note in git history).
#
# Store LF in the repo for everything textual; check out LF for
# cross-platform code (Python runs fine with LF on Windows), CRLF only for
# Windows-native script formats that expect it.

* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.html text eol=lf
*.kts  text eol=lf
*.kt   text eol=lf
*.spec text eol=lf

# gradlew.bat is the only Windows-native script format left; stays CRLF.
*.bat  text eol=crlf

# Binaries — never touch
*.jks  binary
*.zip  binary
*.png  binary
*.ico  binary
*.jpg  binary
*.apk  binary
*.db   binary

# Byte-exact fixtures compared across languages (e.g. Kotlin vs. Python MIME
# output) must never have their line endings touched by checkout, or the
# `* text=auto` rule above silently turns a passing byte-for-byte comparison
# into a platform-dependent one.
android/core/src/test/resources/golden/** -text
*.eml -text
