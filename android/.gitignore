# Machine-specific SDK path
local.properties

# Release signing key — never commit. Back this up somewhere outside this
# machine; losing it means the app can never be updated under the same
# identity once published.
keystore.properties
*.jks
*.keystore

# Build outputs
.gradle/
build/
app/build/
*.apk
*.aab

# Bundled copy of the repo's own NOTICE file (regenerated by
# :app:copyNoticeAsset from ../../NOTICE on every build, same single-source-
# of-truth pattern).
app/src/main/assets/NOTICE.txt

# Android Studio
.idea/
*.iml
.cxx/
captures/
