# OAuth credentials and tokens — never commit these
auth/

# Runtime data - the whole directory, not a list of known filenames.
# This was an enumeration (sync_state.db, inbox/, processed/, dotfiles) until
# SQLite's -shm/-wal sidecars turned up untracked: a WAL holds real message
# rows that have not been checkpointed into the .db yet. Nothing under data/
# is tracked or ever should be, so ignore it wholesale rather than adding a
# line each time the app writes a new kind of file here.
data/

# Claude Code local settings
.claude/

# Debug logs and issue artifacts
Issues/

# PII/secrets audit deliverables - contain real values, must stay untracked
2026-06-25-pii-secrets-audit-and-removal-plan.md
2026-06-25-pii-secrets-cleanup-learnings.md
2026-06-25-replacements.txt
2026-07-22-oauth-verification-road-c-submission.md

# Python bytecode
__pycache__/
*.pyc

# Build artifacts
dist/
build/

# Kotlin incremental-compile cache, emitted next to the Gradle build dir
android/.kotlin/
